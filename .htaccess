# Tomos rewrite rules.
# Place this file in the Tomos install directory, for example:
# www/tomos/.htaccess
# Do not place subdirectory rewrite rules in the parent document-root .htaccess.
# If routing fails on a subdirectory install, uncomment RewriteBase and set it
# to the install path, for example: RewriteBase /tomos/

DirectoryIndex index.php
Options -Indexes

<FilesMatch "^(config\.php|config\.sample\.php|theme-settings\.php)$">
  Order allow,deny
  Deny from all
  Require all denied
</FilesMatch>

<FilesMatch "\.(tmp|log)$">
  Order allow,deny
  Deny from all
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On
# RewriteBase /tomos/

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>
