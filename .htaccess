# Tomos rewrite rules.
# Place this file in the Tomos install directory, for example:
# www/tomos/.htaccess
# Do not place subdirectory rewrite rules in the parent document-root .htaccess.
# If routing fails on a subdirectory install, uncomment RewriteBase and set it
# to the install path, for example: RewriteBase /tomos/

DirectoryIndex index.php
Options -Indexes

<FilesMatch "^(config\.php|config\.sample\.php|theme-settings\.php)$">
  Order allow,deny
  Deny from all
  Require all denied
</FilesMatch>

<FilesMatch "\.(tmp|log)$">
  Order allow,deny
  Deny from all
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On
# RewriteBase /tomos/

# `/post/site-settings.php` is the canonical Site Settings entrypoint.
# Keep the former directory URL only as a compatibility redirect so normal
# Tomos Post navigation never depends on shared-hosting DirectoryIndex behavior.
RewriteRule ^post/settings/?$ post/site-settings.php [R=302,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>
